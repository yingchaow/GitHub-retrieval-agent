GITHUB_TOKEN=

# Optional LLM settings. If omitted, the demo still works in extractive mode
# and returns ranked code excerpts instead of generated answers.
#
# Alibaba Cloud Bailian / DashScope / Tongyi Qwen example:
DASHSCOPE_API_KEY=
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen-plus
#
# Singapore region:
# OPENAI_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#
# US Virginia region:
# OPENAI_BASE_URL=https://dashscope-us.aliyuncs.com/compatible-mode/v1
#
# OpenAI example:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4.1-mini
#
# Provider-neutral aliases also work:
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODEL=

# Optional Qdrant Cloud vector knowledge base.
# If these are empty, the demo uses the local JSON knowledge base + BM25.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=codebase_rag

# Optional embeddings for Qdrant. DashScope text-embedding-v4 supports code
# and can be called through the same OpenAI-compatible base URL.
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024
EMBEDDING_MAX_CHARS=1800
# If you switch to text-embedding-v1, use 1536 dimensions and a new collection.
# EMBEDDING_MODEL=text-embedding-v1
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_MAX_CHARS=1800
# QDRANT_COLLECTION=codebase_rag_v1_1536
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional server settings.
HOST=0.0.0.0
PORT=8000

# Optional indexing performance knobs.
MAX_INDEX_FILES=80
QDRANT_BATCH_SIZE=16
VECTOR_INDEX_MODE=selective
VECTOR_MAX_CHUNKS=120
DEFAULT_CHUNK_LINES=90
PYTHON_CHUNK_LINES=120
MARKDOWN_CHUNK_LINES=90
CHUNK_OVERLAP_LINES=18
HYBRID_RETRIEVAL=1
HYBRID_VECTOR_LIMIT=6
HYBRID_LOCAL_LIMIT=8
HYBRID_RRF_K=60

# Optional query-time context compression.
# Compression is only applied when retrieved context reaches the threshold.
CONTEXT_COMPRESSION=1
CONTEXT_MAX_CONTEXTS=6
CONTEXT_COMPRESSION_THRESHOLD_CHARS=8000
CONTEXT_MAX_CHARS=12000
CONTEXT_SNIPPET_LINES=36
CONTEXT_WINDOW_LINES=2
